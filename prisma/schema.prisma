generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-arm64-openssl-3.0.x", "linux-musl-openssl-3.0.x", "linux-musl-arm64-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model BlogPost {
  id        Int      @id @default(autoincrement())
  slug      String   @unique
  title     String
  content   String
  excerpt   String   @default("")
  tags      String   @default("")
  image     String?
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SiteSettings {
  id          String @id @default("default")
  blogName    String @default("Smart Blog")
  description String @default("A lightweight, database-powered blog")
  authorName  String @default("")
  authorBio   String @default("")
  footerText  String @default("Built with Next.js | Optimized for 500MB Containers")
}
