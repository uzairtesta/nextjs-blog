        "postinstall": "prisma generate"
    },
    "dependencies": {
        "next": "14.1.0",
        "react": "^18.2.0",
        "react-dom": "^18.2.0",
        "date-fns": "^3.2.0",
        "tailwindcss": "^3.4.0",
        "autoprefixer": "^10",
        "postcss": "^8",
        "@prisma/client": "^5.9.1",
        "prisma": "^5.9.1",
        "@types/node": "^20",
        "@types/react": "^18",
        "@types/react-dom": "^18",
        "typescript": "^5"
    }
}